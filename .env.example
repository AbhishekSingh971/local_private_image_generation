# PostgreSQL connection string for persistent face profiles, face photo bytes and generated media.
# Keep your real URL private in .env. Never commit credentials.
# Example shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Optional Stable Diffusion checkpoint configuration:
SD_MODEL_ID=
SD_MODEL_PATH=

# Face-angle pose guidance (Stable Diffusion 1.5 compatible ControlNet).
FACE_POSE_CONTROLNET_ID=lllyasviel/control_v11p_sd15_openpose
FACE_IDENTITY_IP_ADAPTER_ENABLED=true
FACE_IDENTITY_IP_ADAPTER_REPO=h94/IP-Adapter
FACE_IDENTITY_IP_ADAPTER_FILE=ip-adapter-full-face_sd15.bin
FACE_IDENTITY_IP_ADAPTER_SCALE=0.45

# Generic remote GPU worker. Prefer these when using Colab or another cloud host.
# URL must be the HTTPS base URL for the worker (no /api/remote path suffix).
GPU_WORKER_URL=
GPU_WORKER_TOKEN=

# Backward-compatible RunPod settings. If GPU_WORKER_* are blank, these are used.
# For RunPod, URL format is https://<POD_ID>-8000.proxy.runpod.net
RUNPOD_WORKER_URL=
RUNPOD_WORKER_TOKEN=

# Set on the remote GPU worker runtime (Colab or RunPod).
# Must match GPU_WORKER_TOKEN (or RUNPOD_WORKER_TOKEN for old configuration).
REMOTE_API_TOKEN=
GPU_WORKER_PORT=8000

# Optional Hugging Face token for gated/authorized model downloads; keep private.
HF_TOKEN=
