# PostgreSQL connection string for persistent face profiles, face photo bytes and generated media.
# Keep your real URL private in .env. Never commit credentials.
# Example shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Optional Stable Diffusion checkpoint configuration:
# SD_MODEL_ID can point to a compatible Hugging Face Diffusers model repository.
# If set, it takes precedence over the bundled models/stable-diffusion-v1-5 folder.
# SD_MODEL_PATH can point to an existing local Diffusers model folder and takes precedence over SD_MODEL_ID.
# Review the checkpoint license and requirements before using it. Leave both blank to use the bundled model.
SD_MODEL_ID=
SD_MODEL_PATH=

# Face-angle pose guidance (Stable Diffusion 1.5 compatible ControlNet).
# First use downloads the model; the default weights are large, so use a capable GPU/RunPod if local RAM is limited.
FACE_POSE_CONTROLNET_ID=lllyasviel/control_v11p_sd15_openpose

# Optional face-identity image adapter used with the source photo during pose-controlled generation.
FACE_IDENTITY_IP_ADAPTER_ENABLED=true
FACE_IDENTITY_IP_ADAPTER_REPO=h94/IP-Adapter
FACE_IDENTITY_IP_ADAPTER_FILE=ip-adapter-full-face_sd15.bin
FACE_IDENTITY_IP_ADAPTER_SCALE=0.45

# Local app: leave RUNPOD_WORKER_URL/TOKEN unset to keep all inference local.
# Copy this file to .env only when you have deployed your own RunPod GPU worker.
# RunPod Pod proxy URL format: https://<POD_ID>-8000.proxy.runpod.net
RUNPOD_WORKER_URL=
# Must exactly match REMOTE_API_TOKEN set on the GPU worker. Never commit a real token.
RUNPOD_WORKER_TOKEN=

# Set this on the RunPod Pod environment (or its untracked .env file), not only locally.
# Use a long random secret; the same value goes into RUNPOD_WORKER_TOKEN on your local PC.
REMOTE_API_TOKEN=
GPU_WORKER_PORT=8000
