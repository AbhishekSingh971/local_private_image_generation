# Local app: leave RUNPOD_WORKER_URL/TOKEN unset to keep all inference local.
# Copy this file to .env only when you have deployed your own RunPod GPU worker.
# RunPod Pod proxy URL format: https://<POD_ID>-8000.proxy.runpod.net
RUNPOD_WORKER_URL=
# Must exactly match REMOTE_API_TOKEN set on the GPU worker. Never commit a real token.
RUNPOD_WORKER_TOKEN=

# Set this on the RunPod Pod environment (or its untracked .env file), not only locally.
# Use a long random secret; the same value goes into RUNPOD_WORKER_TOKEN on your local PC.
REMOTE_API_TOKEN=
GPU_WORKER_PORT=8000
