# Supabase PostgreSQL connection string for persistent face profiles, photos, LoRA backups and generated media.
# Copy the exact PostgreSQL URI from Supabase Dashboard -> Connect (Session pooler is a good choice for local apps).
# Keep your real URL private in .env. Never commit credentials.
# Preserve sslmode=require and URL-encode reserved characters in the password.
DATABASE_URL=

# Optional Stable Diffusion checkpoint configuration:
SD_MODEL_ID=
SD_MODEL_PATH=

# Face-angle pose guidance (Stable Diffusion 1.5 compatible ControlNet).
FACE_POSE_CONTROLNET_ID=lllyasviel/control_v11p_sd15_openpose
FACE_IDENTITY_IP_ADAPTER_ENABLED=true
FACE_IDENTITY_IP_ADAPTER_REPO=h94/IP-Adapter
FACE_IDENTITY_IP_ADAPTER_FILE=ip-adapter-full-face_sd15.bin
FACE_IDENTITY_IP_ADAPTER_SCALE=0.45

# Provider-neutral remote GPU worker (Google Colab or GHive).
# GHive uses an outbound HTTPS tunnel; Colab keeps its existing tunnel setup.
# Use the HTTPS base URL only; do not append /api/remote/health.
GPU_WORKER_URL=

# Shared secret: set this same value on the app and the remote gpu_worker.py process.
# Keep it private. The browser never receives this token.
REMOTE_API_TOKEN=
GPU_WORKER_PORT=8000

# Optional Hugging Face token for gated/authorized model downloads; keep private.
HF_TOKEN=

# Optional AES-256-GCM key for encrypted PostgreSQL backups.
# Generate a private key with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit your real key or store it in the same location as your backups.
# BACKUP_ENCRYPTION_KEY=

# Optional single-workspace password gate. For public deployments, set APP_ENV=production,
# APP_SECRET_KEY, and either APP_ACCESS_PASSWORD or APP_ACCESS_PASSWORD_HASH.
# Generate a hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
# APP_ENV=development
# APP_SECRET_KEY=
# APP_ACCESS_PASSWORD=
# APP_ACCESS_PASSWORD_HASH=

# AES-256-GCM application-layer encryption for face photos, LoRAs and generated media in PostgreSQL.
# Generate a separate key with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same key on the Flask app and any worker that writes to the same PostgreSQL database.
# FACE_DATA_ENCRYPTION_KEY=
# Optional old key during key rotation; remove only after all old data has been re-encrypted.
# FACE_DATA_ENCRYPTION_KEY_PREVIOUS=

# Optional identity consistency evaluator. Supply your own appropriately licensed ArcFace-compatible ONNX model.
# Install onnxruntime separately when enabling this evaluator; no biometric model weights are bundled.
# FACE_IDENTITY_ONNX_MODEL=
# FACE_IDENTITY_MODEL_VERSION=
